# ─── Application ────────────────────────────────────────────────────────────
APP_ENV=development                # development | staging | production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:3000

# Publicly reachable base URL of the Next.js dashboard (apps/dashboard). Used
# only to build the browser redirect at the end of an OAuth connect flow —
# see the Google/HubSpot sections below. No trailing slash.
DASHBOARD_BASE_URL=http://localhost:3000

# ─── Data stores ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://receptionist:receptionist@localhost:5432/receptionist
REDIS_URL=redis://localhost:6379/0
# Database connections per process (pool + overflow). Defaults 5 + 10; lower
# them if (processes x 15) would exceed your Postgres connection limit.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Fernet key for encrypting per-tenant integration credentials at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# ─── Voice layer (Vapi on Twilio numbers) ───────────────────────────────────
VOICE_PROVIDER=vapi                # vapi | retell (adapter selection)
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=               # any random string; Vapi echoes it back on every webhook

# Publicly reachable base URL of this API — where Vapi sends call and tool-call
# webhooks. Production: your deployed host. Development: an HTTPS tunnel
# (e.g. `cloudflared tunnel --url http://localhost:8000`).
# Required by `make provision`; no trailing slash.
PUBLIC_WEBHOOK_BASE_URL=

# ─── Telephony / SMS (Twilio) ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# ─── LLM (Claude API) ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
LLM_MODEL_PRIMARY=claude-sonnet-5     # in-call reasoning
LLM_MODEL_FAST=claude-haiku-4-5       # classification, summaries, lead scoring
LLM_TIMEOUT_SECONDS=30                # per upstream attempt; the SDK default is 600
LLM_MAX_RETRIES=2

# ─── Embeddings (knowledge base / RAG) ──────────────────────────────────────
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3.5
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=15
EMBEDDING_MAX_RETRIES=1

# Hard ceiling on a read-only in-call tool (FAQ, availability), all hops and
# retries included. Past it the caller hears a fallback instead of silence.
TOOL_DEADLINE_SECONDS=8

# ─── Calendar (Google) ──────────────────────────────────────────────────────
# Register the OAuth client's redirect URI as exactly
# {PUBLIC_WEBHOOK_BASE_URL}/api/v1/integrations/google_calendar/callback
# in the Google Cloud Console — a mismatch fails the exchange, not silently.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ─── CRM (HubSpot) ──────────────────────────────────────────────────────────
# Same requirement as Google above, at
# {PUBLIC_WEBHOOK_BASE_URL}/api/v1/integrations/hubspot/callback
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# ─── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=notifications@example.com

# ─── Observability ──────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── Guardrails ─────────────────────────────────────────────────────────────
MAX_CALL_DURATION_SECONDS=900      # hard cap per call (cost guardrail)
TENANT_DAILY_SPEND_CAP_USD=50      # per-tenant daily spend alert threshold

# ─── Error reporting (optional) ─────────────────────────────────────────────
# Empty = disabled. Request bodies, headers, local variables and personal data
# are never sent (core/observability.py).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
APP_RELEASE=                          # git SHA; falls back to RAILWAY_GIT_COMMIT_SHA
